# Payload CMS + public origin. PAYLOAD_SECRET is required: 32+ random characters.
# Production refuses placeholders.
PAYLOAD_SECRET=
# Payload's Postgres (compose default: 127.0.0.1:5435/notifications_demo).
DATABASE_URL=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Business database: better-auth identities, API keys, apps, notifications,
# deliveries, push subscriptions. Same Postgres server is fine (separate DB).
BUSINESS_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Required: 32+ random characters. Also keys the email unsubscribe HMAC.
BETTER_AUTH_SECRET=
# Optional Google sign-in pair; set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Headless first-admin bootstrap: only this address may sign up before an
# instance admin exists.
AUTH_BOOTSTRAP_EMAIL=

# Web Push (RFC 8030 + VAPID). Generate with `bunx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: or https: URL the push service can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email channel. Provider, sender, and endpoint live in
# src/server/plugins/email/email.config.ts; this is the only secret.
# Gmail: generate an App Password (Google Account → Security → 2-Step Verification
# → App passwords); the account password will not work.
SMTP_PASS=

# WebSocket sidecar fallback only (see README); unused when the stream is in-process.
WS_PORT=3001

# Webhook channel. The signing secret is required (16+ characters); the private-network switch is development only.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_ALLOW_PRIVATE=false

# Seals per-app secrets (webhook signing keys) at rest: base64 of 32 random bytes (openssl rand -base64 32).
# Needed only once an app registers its own webhook secret. Losing it makes those secrets unreadable.
SECRET_ENCRYPTION_KEY=

# Logging.
LOG_PRETTY=true
LOG_VERBOSE=false
LOG_COLOR=auto
