# Build + runtime context. Keep the image lean and secret-free:
# runtime config comes from the container environment, never baked in.
# A bare pattern matches only at the root; `**/` matches at any depth.
**/node_modules
dist
dist-ssr
.git
.gitignore
.vscode
.idea
.tanstack
.nitro
.output
.vinxi
.wrangler
.vercel
__unconfig*

# Secrets — never COPY these into the image, at any depth.
**/.env
**/.env.*
**/*.local

# Payload generated artefacts (regenerate via bunx payload generate:types /
# generate:importmap) — the build stage regenerates them; the runner stage
# copies the fresh files from the build stage instead of the host.
src/payload/payload-types.ts
src/payload/payload-import-map.ts

# Dev / docs / test artefacts not needed at runtime. Agent, CI and graph tooling
# is excluded too: its edits would otherwise invalidate the build layer.
# NOTE: `vendor/` is intentionally NOT ignored — vite.config.ts imports
# vendor/payload-tanstack-vite/* and vendor/sanitize-filename.ts at build time.
tests
docs
.agents
.claude
.github
.superpowers
graphify-out
AGENTS.md
CHANGELOG.md
DESIGN.md
README.md
# Generated by `bun run generate:scalar` in the build stage.
public/scalar
**/.DS_Store
**/*.tsbuildinfo
bun.lockb
**/__pycache__/
**/*.pyc
**/*.pyo
todos.json
**/*.log
coverage/
.turbo/
tmp/
.tmp/
pgdata/
.cta.json

# Read-only reference clones (gotify/ntfy); never imported.
_references
